# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
# 
# @defaultRequired=infer
# @generateTsTypes(path=./env.d.ts)
# ----------

# Cloudflare R2 S3-compatible API settings. Keep access credentials server-side.
# @public
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare API token with Workers AI read/run permissions.
# @sensitive
CLOUDFLARE_API_TOKEN=

# The R2 bucket used by the server.
# @public
R2_BUCKET_NAME=

# Standard endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Use the jurisdiction-specific endpoint if the bucket requires one.
# @public @type=url
R2_ENDPOINT=

# Required by S3-compatible SDKs; R2 uses "auto".
# @public
R2_REGION=auto

# R2 S3 API credentials, scoped to the required bucket and permissions.
# @sensitive
R2_ACCESS_KEY_ID=
# @sensitive
R2_SECRET_ACCESS_KEY=
